<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Home page</title>
</head>
<body>
    <h1>Url Shortner</h1>

    <% if(locals.shortId) {%>
        <p>
            URL Generated : https://organic-space-rotary-phone-wr6vv6x5vjqgcgqrq-8001.app.github.dev/url/<%= locals.shortId %>
            <% } %>
        </p>




    <form method="POST" action="/url">
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label">Enter you Original URL></label>
    <input type="text" name="url" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter your URL" name="originalUrl" required>
  </div>

  <button type="submit" class="btn btn-primary">Generate Short URL</button>
</form>


</body>
</html>